# URL base da API. Vazio = usa o proxy /api do Vite (recomendado em dev).
# Em producao (front hospedado), aponte direto para a API e adicione a origem
# do site em Cors:AllowedOrigins no appsettings da RetaguardaAgendamentoAPI.
VITE_API_BASE_URL=

# Trava de acesso da diretoria: apenas estes e-mails conseguem entrar no app.
# Separe por virgula. Vazio = qualquer login valido da API entra.
VITE_ALLOWED_EMAILS=email-da-dona@exemplo.com

# Passkeys / WebAuthn (digital, PIN do Windows, QR). Mantenha "false" ate a API
# .NET expor as rotas /auth/passkey/*; so entao mude para "true" para o botao
# "Entrar com passkey" e o "Meus dispositivos" aparecerem. Exige HTTPS.
VITE_PASSKEYS_ENABLED=false
