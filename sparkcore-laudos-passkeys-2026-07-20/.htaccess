# Headers de seguranca do site (laudos.clinicaideia.com.br) — item M2-FRONT
# do laudo de pentest 17/07/2026 (ver PENDENCIAS_SEGURANCA.txt).
# Protege o token no localStorage (CSP contra XSS) e força HTTPS (HSTS).
Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Content-Security-Policy "default-src 'self'; connect-src 'self' https://api.clinicaideia.com.br; frame-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'"

# O app e PWA. Esses arquivos precisam sempre revalidar para o celular nao
# continuar rodando um service worker/HTML antigo depois de uma publicacao.
<FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest|workbox-.*\.js)$">
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header always set Pragma "no-cache"
  Header always set Expires "0"
</FilesMatch>
